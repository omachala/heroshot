{
  "ignoreDependencies": ["tailwindcss", "heroshot", "postcss", "plyr", "svelte"],
  "ignore": [
    "editor/**",
    "src/capture.ts",
    "src/ui.ts",
    "docs/public/palette.css",
    "integrations/examples/**",
    "integrations/shared/virtual.d.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "docs": {
      "entry": [".vitepress/config.ts"]
    },
    "integrations/vue": {
      "entry": ["src/index.ts", "src/__tests__/*.ts"]
    },
    "integrations/react": {
      "entry": ["src/index.ts", "src/__tests__/*.tsx"]
    },
    "integrations/svelte": {
      "entry": ["src/index.ts"]
    },
    "integrations/next": {
      "entry": ["src/index.ts"]
    },
    "integrations/shared": {
      "entry": ["index.ts", "vitePlugin.ts", "docusaurusPlugin.ts", "nextPlugin.ts"]
    }
  }
}
