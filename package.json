{
  "name": "heroshot",
  "version": "0.6.1",
  "description": "Define your screenshots once, update them forever with one command",
  "type": "module",
  "author": "Ondrej Machala",
  "license": "MIT",
  "bin": {
    "heroshot": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./vitepress": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./vuepress": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./nuxt": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./docusaurus": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./nextra": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./mdx": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./plugins/vite": {
      "types": "./dist/integrations/shared/vitePlugin.d.ts",
      "import": "./dist/integrations/shared/vitePlugin.js"
    },
    "./plugins/docusaurus": {
      "types": "./dist/integrations/shared/docusaurusPlugin.d.ts",
      "import": "./dist/integrations/shared/docusaurusPlugin.js",
      "require": "./dist/integrations/shared/docusaurusPlugin.cjs"
    },
    "./virtual": {
      "types": "./dist/integrations/shared/virtual.d.ts"
    }
  },
  "files": [
    "dist",
    "editor/dist",
    "README.md"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "build:editor": "vite build --config editor/vite.config.ts",
    "build:integrations": "pnpm --filter './integrations/*' build",
    "build:integrations:vue": "pnpm --filter './integrations/vue' build",
    "build:integrations:react": "pnpm --filter './integrations/react' build",
    "test:integrations": "pnpm --filter './integrations/*' test:run",
    "lint:integrations": "pnpm --filter './integrations/react' lint",
    "typecheck:integrations": "pnpm --filter './integrations/vue' --filter './integrations/react' typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:editor": "vitest run --config editor/vite.config.ts",
    "test:editor:coverage": "vitest run --config editor/vite.config.ts --coverage",
    "test:editor:e2e": "playwright test --config editor/playwright.config.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "typecheck:editor": "tsc --noEmit -p editor/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo-editor",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint src/",
    "lint:editor": "eslint --cache --cache-location node_modules/.cache/eslint-editor editor/src/",
    "check:svelte": "pnpm build:editor 2>&1 | grep -q '\\[vite-plugin-svelte\\].*warning' && echo 'Svelte warnings found!' && exit 1 || exit 0",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint src/ --fix",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm knip && pnpm test:run",
    "check:editor": "pnpm typecheck:editor && pnpm lint:editor && pnpm test:editor",
    "docs:dev": "rm -rf docs/.vitepress/cache && pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "fix": "pnpm format && pnpm lint:fix",
    "changeset": "changeset",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "./scripts/pre-commit.sh",
    "commit-msg": "./scripts/commit-msg.sh $1"
  },
  "keywords": [
    "screenshot",
    "cli",
    "automation",
    "documentation",
    "playwright"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.16.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.0",
    "@vitest/browser": "^4.0.17",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-svelte": "^3.14.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^26.0.0",
    "knip": "^5.80.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "simple-git-hooks": "^2.11.1",
    "svelte": "^5.46.1",
    "svelte-eslint-parser": "^1.4.1",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^12.1.0",
    "playwright": "^1.49.0",
    "sharp": "^0.33.0",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.0.0",
    "vitepress": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vitepress": {
      "optional": true
    }
  }
}
