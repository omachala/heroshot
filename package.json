{
  "name": "heroshot",
  "version": "0.19.3",
  "description": "Define your screenshots once, update them forever with one command",
  "type": "module",
  "author": "Ondrej Machala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omachala/heroshot"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "bin": {
    "heroshot": "dist/cli/cli.js",
    "heroshot-mcp": "dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./vue": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./vitepress": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./vuepress": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./nuxt": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./docusaurus": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./nextra": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./mdx": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./svelte": {
      "types": "./dist/integrations/svelte/index.d.ts",
      "import": "./dist/integrations/svelte/index.js"
    },
    "./sveltekit": {
      "types": "./dist/integrations/svelte/index.d.ts",
      "import": "./dist/integrations/svelte/index.js"
    },
    "./next": {
      "types": "./dist/integrations/next/index.d.ts",
      "import": "./dist/integrations/next/index.js"
    },
    "./plugins/vite": {
      "types": "./dist/integrations/shared/vitePlugin.d.ts",
      "import": "./dist/integrations/shared/vitePlugin.js"
    },
    "./plugins/docusaurus": {
      "types": "./dist/integrations/shared/docusaurusPlugin.d.ts",
      "import": "./dist/integrations/shared/docusaurusPlugin.js",
      "require": "./dist/integrations/shared/docusaurusPlugin.cjs"
    },
    "./plugins/next": {
      "types": "./dist/integrations/shared/nextPlugin.d.ts",
      "import": "./dist/integrations/shared/nextPlugin.js",
      "require": "./dist/integrations/shared/nextPlugin.cjs"
    },
    "./virtual": {
      "types": "./dist/integrations/shared/virtual.d.ts"
    }
  },
  "files": [
    "dist",
    "editor/dist",
    "README.md"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx src/cli/cli.ts",
    "build": "tsdown",
    "build:binary": "bun run scripts/build-binary.ts",
    "build:binary:single": "bun run scripts/build-binary.ts --single",
    "build:editor": "vite build --config editor/vite.config.ts",
    "build:integrations": "pnpm --filter './integrations/*' build",
    "build:integrations:vue": "pnpm --filter './integrations/vue' build",
    "build:integrations:react": "pnpm --filter './integrations/react' build",
    "build:integrations:svelte": "pnpm --filter './integrations/svelte' build",
    "build:integrations:next": "pnpm --filter './integrations/next' build",
    "test:integrations": "pnpm --filter './integrations/*' test:run",
    "lint:integrations": "pnpm --filter './integrations/react' lint",
    "typecheck:integrations": "pnpm --filter './integrations/vue' --filter './integrations/react' typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:editor": "vitest run --config editor/vite.config.ts",
    "test:editor:coverage": "vitest run --config editor/vite.config.ts --coverage",
    "test:examples": "for dir in sveltekit nextjs nuxt vitepress docusaurus; do echo \"Testing $dir...\" && (cd integrations/examples/$dir && npx playwright test) || exit 1; done",
    "test:editor:e2e": "playwright test --config editor/playwright.config.ts",
    "test:editor:demo": "playwright test --config editor/playwright.demo.config.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "typecheck:editor": "tsc --noEmit -p editor/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo-editor",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint src/",
    "lint:editor": "eslint --cache --cache-location node_modules/.cache/eslint-editor editor/src/",
    "check:svelte": "pnpm build:editor 2>&1 | grep -q '\\[vite-plugin-svelte\\].*warning' && echo 'Svelte warnings found!' && exit 1 || exit 0",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint src/ --fix",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm knip && pnpm test:run",
    "check:editor": "pnpm typecheck:editor && pnpm lint:editor && pnpm test:editor",
    "docs:generate": "tsx scripts/generate-action-docs.ts",
    "docs:dev": "rm -rf docs/.vitepress/cache && pnpm --dir docs run dev",
    "docs:build": "pnpm docs:generate && pnpm --dir docs run build",
    "fix": "pnpm format && pnpm lint:fix",
    "changeset": "changeset",
    "prepare": "lefthook install"
  },
  "keywords": [
    "screenshot",
    "cli",
    "automation",
    "documentation",
    "playwright"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.16.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^26.0.0",
    "knip": "^5.80.0",
    "lefthook": "^2.1.9",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "svelte": "^5.56.1",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^12.1.0",
    "p-limit": "^7.2.0",
    "playwright": "^1.60.0",
    "zod": "^4.3.5"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "svelte": ">=5.0.0",
    "vitepress": ">=1.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vitepress": {
      "optional": true
    }
  }
}
